GITHUB_PAT=ghp_replace_me
# Optional: leave empty to watch every repository owned by GITHUB_USERNAME.
GITHUB_REPOS=oliverruoff/pi.lot,oliverruoff/cooprpgarena
GITHUB_USERNAME=oliverruoff
GITHUB_LABEL_TRIGGER=agent
GITHUB_LABEL_IN_PROGRESS=agent-in-progress
GITHUB_LABEL_DONE=agent-done
GITHUB_BASE_BRANCH=main
# GITHUB_PR_TARGET=main
PI_ARGS=--model openai/gpt-5
BRO_REASONING_EFFORT=medium
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
BRO_POLL_INTERVAL_SECONDS=900
BRO_HEARTBEAT_INTERVAL_SECONDS=1200
BRO_HEARTBEAT_STALE_AFTER_SECONDS=2700
BRO_RUN_TIMEOUT_SECONDS=5400
BRO_LOG_LEVEL=INFO
